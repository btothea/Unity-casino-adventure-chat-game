  m_Script: {fileID: 11500000, guid: 998c549ea8c132047bb904df2f2f9725, type: 3}
  m_Name: Dialogue_HighRollerDealer
  m_EditorClassIdentifier: 
  dialogueName: High Roller Dealer
  fullDialogueTree: 'Start:

    High Roller Dealer: This is it. One final game.
    Everything you have... or nothing at all.

    

    House Wheel:

    High
    Roller Dealer: Spin the House Wheel. It can make you rich, or it can take everything.

    

    Choice
    1:

    Spin the House Wheel

    

    Choice 2:

    End Game

    

    Choice
    3:

    Return to Casino Floor

    

    Ending Check:

    Escape the System
    requires moneyAmount >= 500, knowsSecret == true, helpedGambler == true, hasGoldenCard
    == true, and hasHouseLedger == true.

    

    Big Winner requires moneyAmount
    >= 200 and tookRisk == true.

    

    Lost Everything triggers if the player
    does not meet the other ending requirements or moneyAmount <= 0.'
